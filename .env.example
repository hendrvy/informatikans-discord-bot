DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_discord_channel_id_here
JOOBLE_API_KEY=your_jooble_api_key_here
CLIENT_ID=your_discord_application_client_id_here
GUILD_ID=your_discord_server_guild_id_here
POSTED_JOBS_DB_PATH=

# Prefix untuk legacy text command (contoh: $ping, $say)
PREFIX=$

# ID channel (pisahkan dengan koma jika lebih dari satu) yang dipantau untuk
# deteksi format perkenalan member baru (autorole)
AUTOROLE_CHANNEL_IDS=channel_id_1,channel_id_2

# Nama role yang diberikan ke member baru setelah perkenalan terdeteksi
AUTOROLE_ROLE_NAME=Informatikans

# Channel untuk announce scheduled event & reminder (default: sama dengan CHANNEL_ID)
EVENT_ANNOUNCE_CHANNEL_ID=channel_id_here

# (Opsional) User ID Discord yang menerima DM alert kritikal (scraper rusak).
# Kosongkan untuk menonaktifkan.
ADMIN_USER_ID=your_discord_user_id_here

# ==============================
# AUTO-DEPLOY WEBHOOK (opsional)
# ==============================
# Port & path webhook listener (harus cocok dengan Payload URL di GitHub)
WEBHOOK_PORT=9000
WEBHOOK_PATH=/webhook
# Branch yang memicu deploy saat push
WEBHOOK_BRANCH=main
# Secret webhook GitHub (X-Hub-Signature-256). Kosongkan dulu bila
# webhook GitHub belum pakai secret. WAJIB disamakan dengan Secret di
# settings webhook GitHub.
WEBHOOK_SECRET=
# Set false untuk mematikan listener autodeploy sepenuhnya
WEBHOOK_ENABLED=true
